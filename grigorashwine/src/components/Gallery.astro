---
import gallery from '../content/gallery.json';
---

<section id="gallery">
  <div class="gallery-all text-center py-8" style="background-color: var(--white)">
    <h2 class="text-4xl" style="color: var(--wine-red)">Galerie</h2>
    <h3 class="text-lg" style="color: var(--text-muted)">
      Povestea noastră în imagini
    </h3>

    <div class="gallery-content">
      {gallery.items.map((item) => (
        <div class="gallery-item">
          <img src={item.image} alt={item.caption} />
          <div class="gallery-desc">
            <p>{item.caption}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>