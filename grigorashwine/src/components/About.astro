---
import about from "../content/about.json";
---

<section id="about" class="py-16" style="background-color: var(--cream)">
  <div
    class="about-content flex items-center gap-16 max-w-5xl mx-auto flex-wrap"
  >
    <div
      class="about-image flex justify-center items-center min-w-0 w-full md:w-auto md:flex-1"
    >
      <img
        src={about.image}
        alt="about"
        class="w-full md:w-[400px] md:min-w-[400px] md:max-w-[400px] rounded-lg shadow-lg transition-transform duration-200 hover:scale-[1.03]"
        style="background-color: var(--white)"
      />
    </div>
    <div
      class="about-text min-w-[260px] max-w-[700px] text-[1.1em] leading-[1.7] px-[1.5em]"
      style="color: var(--text-dark); flex: 2"
    >
      <h2
        class="text-[2.5em] mb-[0.5em] relative"
        style="color: var(--wine-red)"
      >
        {about.heading}
      </h2>
      {about.paragraphs.map((paragraph) => <p class="mb-4">{paragraph}</p>)}
    </div>
    <p
      class="about-end w-full max-w-2xl mx-auto text-lg italic text-center leading-relaxed -mt-10"
      style="color: var(--text-muted)"
    >
      {about.quote}
    </p>
  </div>

  <!-- Values cards -->
  <div
    class="about-values grid grid-cols-1 md:grid-cols-3 gap-10 mt-12 mx-auto px-6 max-w-6xl"
  >
    <!-- card 1 -->
    <div
      class="flex flex-col items-center text-center p-8 rounded-xl shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.03]"
      style="background-color: var(--white)"
    >
      <div
        class="flex items-center justify-center w-16 h-16 aspect-square text-4xl rounded-full mb-4"
        style="background: rgba(139, 44, 44, 0.1); color: var(--wine-red)"
      >
        <i class="fa-sharp fa-solid fa-heart"></i>
      </div>
      <h3 class="text-3xl mb-2" style="color: var(--wine-red)">Pasiune</h3>
      <p style="color: var(--text-muted)">
        Iubim ceea ce facem și se simte în fiecare pahar de vin
      </p>
    </div>

    <!-- card 2 -->
    <div
      class="flex flex-col items-center text-center p-8 rounded-xl shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.03]"
      style="background-color: var(--white)"
    >
      <div
        class="flex items-center justify-center w-16 h-16 aspect-square text-4xl rounded-full mb-4"
        style="background: rgba(139, 44, 44, 0.1); color: var(--wine-red)"
      >
        <i class="fa-sharp fa-solid fa-people-group"></i>
      </div>
      <h3 class="text-3xl mb-2" style="color: var(--wine-red)">Familie</h3>
      <p style="color: var(--text-muted)">
        O afacere de familie condusă cu grijă și dedicare
      </p>
    </div>

    <!-- card 3 -->
    <div
      class="flex flex-col items-center text-center p-8 rounded-xl shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.03]"
      style="background-color: var(--white)"
    >
      <div
        class="flex items-center justify-center w-16 h-16 aspect-square text-4xl rounded-full mb-4"
        style="background: rgba(139, 44, 44, 0.1); color: var(--wine-red)"
      >
        <i class="fa-sharp fa-solid fa-award"></i>
      </div>
      <h3 class="text-3xl mb-2" style="color: var(--wine-red)">Calitate</h3>
      <p style="color: var(--text-muted)">
        Punem suflet în fiecare detaliu, ca gustul să fie adevărat
      </p>
    </div>
  </div>
</section>
