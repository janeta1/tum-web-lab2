---
import hero from '../content/hero.json';
---

<section id="hero">
  <div class="hero-content">
    <h1>{hero.title}</h1>
    <p class="subtitle">{hero.subtitle}</p>

    <div class="hero-cta">
      <a
        href="https://www.instagram.com/grigoraswine/"
        target="_blank"
        class="btn primary">Descoperă-ne pe Instagram</a
      >
      <a href="#contact" class="btn secondary">Vino la o degustare</a>
    </div>
  </div>

  <div class="hero-image">
    <img src={hero.image} alt="hero" />
  </div>
</section>
