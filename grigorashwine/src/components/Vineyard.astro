---
import vineyard from "../content/vineyard.json";
---

<section id="vineyard" class="py-[4em]" style="background-color: var(--white)">
  <div class="vineyard-all max-w-[1100px] mx-auto items-center">
    <h2
      class="text-[2.5em] mb-[0.1em] text-center relative"
      style="color: var(--wine-red)"
    >
      {vineyard.heading}
    </h2>
    <h3
      class="text-[1.1em] leading-[1.7] px-[1.5em] max-w-[800px] mx-auto text-center"
      style="color: var(--text-muted)"
    >
      {vineyard.subtitle}
    </h3>
  </div>

  <div
    class="vineyard-content flex items-center gap-16 max-w-[1100px] mx-auto flex-wrap"
  >
    <div
      class="vineyard-text min-w-[600px] text-[1.1em] leading-[1.7] pt-8"
      style="color: var(--text-dark); flex: 1"
    >
      {
        vineyard.paragraphs.map((paragraph) => (
          <p class="mb-[1.1em]">{paragraph}</p>
        ))
      }
    </div>

    <div
      class="vineyard-image flex justify-center items-center max-w-full"
      style="flex: 2"
    >
      <img
        src={vineyard.image}
        alt="vineyard"
        class="w-full max-w-full rounded-lg transition-transform duration-200 hover:scale-[1.03]"
        style="
                box-shadow: 0 4px 24px var(--border-light);
                background-color: var(--white);
              "
      />
    </div>
  </div>
</section>
