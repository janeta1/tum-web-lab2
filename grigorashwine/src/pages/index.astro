---
import '../styles/global.css';
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import About from '../components/About.astro'
---

<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Struguraș de la Grigoraș</title>
    
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    
  </head>
  <body>
    
	<Header />
    <main>
      <Hero />
      <About />

      <section
        id="vineyard"
        class="py-[4em]"
        style="background-color: var(--white)"
      >
        <div class="vineyard-all max-w-[1100px] mx-auto items-center">
          <h2
            class="text-[2.5em] mb-[0.1em] text-center relative"
            style="color: var(--wine-red)"
          >
            Vinificație
          </h2>
          <h3
            class="text-[1.1em] leading-[1.7] px-[1.5em] max-w-[800px] mx-auto text-center"
            style="color: var(--text-muted)"
          >
            De la vie la sticlă: procesul nostru de producție a vinului de
            calitate
          </h3>
        </div>

        <div
          class="vineyard-content flex items-center gap-16 max-w-[1100px] mx-auto flex-wrap"
        >
          <div
            class="vineyard-text min-w-[600px] text-[1.1em] leading-[1.7] pt-8"
            style="color: var(--text-dark); flex: 1"
          >
            <p class="mb-[1.1em]">
              La noi, vinul începe cu atenție și răbdare. Strugurii sunt culeși
              cu mâna noastră, la momentul potrivit, și fiecare bob e privit cu
              grijă, pentru ca fiecare sticlă să poarte ceva din sufletul
              nostru. Ne place să lucrăm în loturi mici, unde fiecare pas
              contează și nimic nu e lăsat la voia întâmplării.
            </p>
            <p class="mb-[1.1em]">
              Fermentarea e un proces de observație și răbdare. Urmărim cum
              mustul se transformă, cum aromele se adună și cum vinul își
              găsește echilibrul. Nu grăbim lucrurile - îl lăsăm să evolueze în
              ritmul lui, a aromele să se păstreze naturale și autentice. Ne
              place să urmărim cum fiecare lot își găsește propriul caracter,
              fără să forțăm lucrurile.
            </p>
            <p class="mb-[1.1em]">
              Chiar dacă nu avem o podgorie mare, locul în care lucrăm ne
              definește. Zgurița ne oferă un climat blând, cu zile însorite și
              nopți răcoroase, care ajută strugurii să se coacă frumos și să
              păstreze naturalețea lor. Aerul curat, pământul bogat și liniștea
              satului se simt în vin, fără să fie nevoie să spunem prea multe.
            </p>
            <p class="mb-[1.1em]">
              La final, vinul este maturat cu grijă și supravegheat constant.
              Fiecare sticlă spune povestea noastră - a familiei, a muncii și a
              grijii pentru detalii. E un vin făcut cu pasiune, simplu, sincer
              și aproape de inimă.
            </p>
          </div>

          <div
            class="vineyard-image flex justify-center items-center max-w-full"
            style="flex: 2"
          >
            <img
              src="/images/vineyard.jpg"
              alt="vineyard"
              class="w-full max-w-full rounded-lg border-4 border-gold transition-transform duration-200 hover:scale-[1.03]"
              style="
                box-shadow: 0 4px 24px var(--border-light);
                background-color: var(--white);
              "
            />
          </div>
        </div>
      </section>

      <section
        id="events"
        class="py-[4em]"
        style="background-color: var(--cream)"
      >
        <div class="events-all max-w-[1200px] mx-auto px-[1.5rem]">
          <h2
            class="text-[2.5em] mb-[0.1em] relative text-center"
            style="color: var(--wine-red)"
          >
            Evenimente
          </h2>
          <h3
            class="text-[1.1em] leading-[1.7] px-[1.5em] max-w-[800px] mx-auto text-center"
            style="color: var(--text-muted)"
          >
            Momente memorabile petrecute împreună
          </h3>

          <div
            class="events-content grid grid-cols-1 gap-8 mt-8 max-w-[1200px] mx-auto"
          >
            <div
              class="event-card text-center rounded-[1.25rem] p-8 px-6"
              style="
                background-color: var(--white);
                box-shadow: 0 4px 16px var(--shadow-soft);
              "
            >
              <h4
                class="text-[2rem] text-left mb-[0.7rem]"
                style="color: var(--wine-red)"
              >
                Wine Grunge Party 2022
              </h4>
              <p
                class="text-[1.1rem] text-left mb-4"
                style="color: var(--text-muted)"
              >
                Wine Grunge Party de la Goldhaus a fost despre muzică, ritm și
                vin bun. Pe 28 octombrie, alături de Petru Moiseev, show de tobe
                și DJ, am petrecut o seară intensă, exact așa cum ne place, cu
                vinurile Struguraș de la Grigoraș alături.
              </p>
              <div class="event-info">
                <p
                  class="text-[0.9rem] text-left mb-0"
                  style="color: var(--wine-red)"
                >
                  <b>Data:</b> Octombrie 2022
                </p>
                <p
                  class="text-[0.9rem] text-left mb-0"
                  style="color: var(--wine-red)"
                >
                  <b>Locație:</b> Goldhaus Bier & Steakhaus
                </p>
              </div>
              <h5
                class="text-[1.5rem] text-center mt-4 mb-[-2rem]"
                style="color: var(--wine-red)"
              >
                Galerie foto
              </h5>
              <div class="event-slideshow">
                <div class="event-track">
                  <ul class="content">
                    <li>
                      <img
                        src="/images/gp1.jpg"
                        alt="event1"
                        class="event-img"
                      />
                    </li>
                    <li>
                      <img
                        src="/images/gp2.jpg"
                        alt="event2"
                        class="event-img"
                      />
                    </li>
                    <li>
                      <img
                        src="/images/gp3.jpg"
                        alt="event3"
                        class="event-img"
                      />
                    </li>
                    <li>
                      <img
                        src="/images/gp4.jpg"
                        alt="event4"
                        class="event-img"
                      />
                    </li>
                    <li>
                      <img
                        src="/images/gp5.jpg"
                        alt="event5"
                        class="event-img"
                      />
                    </li>
                    <li>
                      <img
                        src="/images/gp6.jpg"
                        alt="event6"
                        class="event-img"
                      />
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="events-cta max-w-[1200px] w-full mx-auto my-8 px-[1.5rem] box-border"
        >
          <div
            class="events-cta-text w-full text-center rounded-[1.25rem] p-8 px-6 box-border"
            style="
              background-color: var(--white);
              box-shadow: 0 4px 16px var(--shadow-soft);
            "
          >
            <h2 class="text-[1.5rem] mb-4" style="color: var(--wine-red)">
              Vrei să participi la următorul eveniment?
            </h2>
            <p class="text-[1.1rem] mb-6" style="color: var(--text-muted)">
              Urmărește-ne pe rețelele sociale pentru a afla despre viitoarele
              degustări și evenimente speciale. Abia așteptăm să ne întâlnim și
              să împărtășim momente frumoase în jurul unui pahar de vin bun!
            </p>
            <div class="events-cta-btns flex justify-center gap-4 flex-wrap">
              <a
                href="https://www.instagram.com/grigoraswine/"
                target="_blank"
                class="btn primary"
                style="border-radius: 12px; width: 310px"
                >Urmărește-ne pe Instagram</a
              >
              <a
                href="https://www.facebook.com/grigorashwinery"
                target="_blank"
                class="btn primary"
                style="border-radius: 12px; width: 310px"
                >Urmărește-ne pe Facebook</a
              >
            </div>
          </div>
        </div>
      </section>

      <section id="gallery">
        <div
          class="gallery-all text-center py-8"
          style="background-color: var(--white)"
        >
          <h2 class="text-4xl" style="color: var(--wine-red)">Galerie</h2>
          <h3 class="text-lg" style="color: var(--text-muted)">
            Povestea noastră în imagini
          </h3>

          <div class="gallery-content">
            <div class="gallery-item">
              <img src="/images/gl1.jpg" alt="gallery1" />
              <div class="gallery-desc">
                <p>Darul naturii în fiecare sticlă</p>
              </div>
            </div>

            <div class="gallery-item">
              <img src="/images/gl2.jpg" alt="gallery1" />
              <div class="gallery-desc">
                <p>Creat cu grijă, prețuit cu dragoste</p>
              </div>
            </div>

            <div class="gallery-item">
              <img src="/images/gl3.jpg" alt="gallery1" />
              <div class="gallery-desc">
                <p>Un gust al tradiției</p>
              </div>
            </div>

            <div class="gallery-item">
              <img src="/images/gl4.jpg" alt="gallery1" />
              <div class="gallery-desc">
                <p>O poveste în fiecare picătură</p>
              </div>
            </div>

            <div class="gallery-item">
              <img src="/images/gl5.jpg" alt="gallery1" />
              <div class="gallery-desc">
                <p>Momente de împărtășit</p>
              </div>
            </div>

            <div class="gallery-item">
              <img src="/images/gl6.jpg" alt="gallery1" />
              <div class="gallery-desc">
                <p>Amintiri turnate în fiecare pahar</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="contact">
        <div class="contact-all">
          <h2>Contactează-ne</h2>
          <h3>
            Vino să ne vizitezi sau trimite-ne un mesaj. Te așteptăm cu drag!
          </h3>

          <div class="contact-content">
            <div class="contact-card contact-info">
              <h4>Informații de contact</h4>
              <div class="info-item">
                <div class="label">
                  <p>
                    <i
                      class="fa-solid fa-map-marker-alt"
                      aria-hidden="true"
                    ></i>
                    <b>Adresă:</b>
                  </p>
                </div>
                <p class="info-value">
                  Strada Independenței 5, Zgurița, Soroca, Republica Moldova
                </p>
              </div>
              <div class="info-item">
                <div class="label">
                  <p>
                    <i class="fa-solid fa-phone" aria-hidden="true"></i>
                    <b>Telefon:</b>
                  </p>
                </div>
                <p class="info-value">+373 0697 83 125</p>
              </div>
              <div class="info-item">
                <div class="label">
                  <p>
                    <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                    <b>Email:</b>
                  </p>
                </div>
                <p class="info-value">
                  <a href="mailto:grigorashwinery@gmail.com" target="_blank"
                    >contact@grigorashwinery.md</a
                  >
                </p>
              </div>
              <div class="info-item">
                <div class="label">
                  <p>
                    <i class="fa-solid fa-clock" aria-hidden="true"></i>
                    <b>Program de vizitare:</b>
                  </p>
                </div>
                <p class="info-value">
                  Luni - Vineri: 10:00 - 18:00<br />Sâmbătă: 10:00 - 14:00<br />Duminică:
                  Închis
                </p>
                <p class="info-note">
                  *Vizitele ghidate necesită programare în avans.
                </p>
              </div>

              <div class="divider" role="separator" aria-hidden="true"></div>
              <p class="contact-quote">
                "Vinul bun se savurează în companie bună. Așteptăm cu nerăbdare
                să auzim de la tine!"
              </p>
            </div>

            <div class="contact-card contact-form">
              <h4>Trimite-ne un mesaj</h4>
              <p>Completează formularul și îți vom răspunde în curând</p>
              <form id="contact-details" action="#" method="post" novalidate>
                <label for="name">Nume complet *:</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Ion Popescu"
                  required
                />

                <label for="email">Email *:</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="ion.popescu@exemplu.com"
                  required
                />

                <label for="phone">Telefon:</label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  placeholder="+373 11 000 11"
                />

                <label for="message">Mesaj *:</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="Scrie-ne mesajul tău aici..."
                  required
                ></textarea>

                <button type="button" class="btn primary" target="_blank">
                  Trimite
                </button>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer
      class="py-12 px-6"
      style="
        background-color: var(--wine-dark);
        color: rgba(255, 255, 255, 0.9);
      "
    >
      <div
class="max-w-6xl mx-auto grid grid-cols-1 gap-8 items-start md:grid-cols-3" style="align-items: start"      >
        <div>
          <h3 class="text-2xl font-semibold mb-2">Struguraș de la Grigoraș</h3>
          <p class="text-white/90 mb-2">
            Vin de casă tradițional din inima Moldovei. Pasiune și grijă în
            fiecare sticlă.
          </p>
          <div class="mt-4 flex gap-2">
            <a
              href="https://www.facebook.com"
              target="_blank"
              aria-label="Facebook"
              class="inline-flex items-center justify-center w-12 h-12 bg-white/30 rounded-full text-white/90 text-2xl no-underline"
              ><i class="fa-brands fa-facebook-f"></i
            ></a>
            <a
              href="https://www.instagram.com"
              target="_blank"
              aria-label="Instagram"
              class="inline-flex items-center justify-center w-12 h-12 bg-white/30 rounded-full text-white/90 text-2xl no-underline"
              ><i class="fa-brands fa-instagram"></i
            ></a>
            <a
              href="mailto:grigorashwinery@gmail.com"
              aria-label="Email"
              class="inline-flex items-center justify-center w-12 h-12 bg-white/30 rounded-full text-white/90 text-2xl no-underline"
              ><i class="fa-regular fa-envelope"></i
            ></a>
          </div>
        </div>

        <nav class="footer-nav block max-w-full box-border ml-8">
          <h4 class="text-xl mb-3">Navigare</h4>
          <ul class="list-none p-0 m-0 flex flex-col gap-2">
            <li>
              <a href="#hero" class="text-white/90 no-underline">→ Acasă</a>
            </li>
            <li>
              <a href="#about" class="text-white/90 no-underline"
                >→ Despre noi</a
              >
            </li>
            <li>
              <a href="#vineyard" class="text-white/90 no-underline"
                >→ Vinificație</a
              >
            </li>
            <li>
              <a href="#events" class="text-white/90 no-underline"
                >→ Evenimente</a
              >
            </li>
            <li>
              <a href="#gallery" class="text-white/90 no-underline"
                >→ Galerie</a
              >
            </li>
            <li>
              <a href="#contact" class="text-white/90 no-underline"
                >→ Contactează-ne</a
              >
            </li>
          </ul>
        </nav>

        <div>
          <h4 class="text-xl mb-3">Contactează-ne</h4>
          <div class="flex gap-2 items-start my-2">
            <i class="fa-solid fa-location-dot text-white/90 w-7"></i>
            <div class="text-white/90">
              Strada Independenței 5, Zgurița, Soroca,<br />Republica Moldova
            </div>
          </div>
          <div class="flex gap-2 items-start my-2">
            <i class="fa-solid fa-phone text-white/90 w-7"></i>
            <div class="text-white/90">+373 60 123 456</div>
          </div>
          <div class="flex gap-2 items-start my-2">
            <i class="fa-regular fa-envelope text-white/90 w-7"></i>
            <div class="text-white/90">
              <a
                href="mailto:grigorashwinery@gmail.com"
                class="text-white/90 no-underline"
                >grigorashwinery@gmail.com</a
              >
            </div>
          </div>
        </div>
      </div>

      <div
        class="max-w-6xl mx-auto mt-7 flex justify-between gap-4 items-center border-t border-white/10 pt-4 flex-col sm:flex-row"
      >
        <p class="m-0 text-white/80 text-sm">
          © 2026 Struguraș de la Grigoraș. Toate drepturile rezervate.
        </p>
        <p class="m-0 text-white/80 text-sm text-right">
          Consumul excesiv de alcool este dăunător sănătății.
        </p>
      </div>
    </footer>

    <div id="mascot-wrapper">
      <img id="mascot" src="/images/mascot.svg" alt="Mascot" />
      <div id="mascot-text">
        Mesajul tău e ca un vin bun: abia aștept să-l descopăr!
      </div>
    </div>

    <script>
      const toggle = document.getElementById("darkToggle");
      const mobileToggle = document.getElementById("mobileDarkToggle");
      const logo = document.getElementById("siteLogo");
      const menuToggle = document.getElementById("menuToggle");
      const mobileMenu = document.getElementById("mobileMenu");
      const close = document.getElementById("mobileMenuClose");

      function updateTheme() {
        const isDark = document.body.classList.contains("dark-mode");

        if (isDark) {
          logo.src = "/images/logo_white.png";
          localStorage.setItem("theme", "dark");
          toggle.innerHTML = '<i class="fa-regular fa-sun"></i>';
          mobileToggle.innerHTML = '<i class="fa-regular fa-sun"></i>';
        } else {
          logo.src = "/images/logo_red.png";
          localStorage.setItem("theme", "light");
          toggle.innerHTML = '<i class="fa-regular fa-moon"></i>';
          mobileToggle.innerHTML = '<i class="fa-regular fa-moon"></i>';
        }
      }

      toggle.addEventListener("click", () => {
        document.body.classList.toggle("dark-mode");
        updateTheme();
      });

      mobileToggle.addEventListener("click", () => {
        document.body.classList.toggle("dark-mode");
        updateTheme();
      });

      menuToggle.addEventListener("click", () => {
        mobileMenu.classList.add("open");
        mobileMenu.removeAttribute("inert");
      });

      close.addEventListener("click", () => {
        mobileMenu.classList.remove("open");
        mobileMenu.setAttribute("inert", "");
      });

      mobileMenu.querySelectorAll(".mobile-nav-link").forEach((link) =>
        link.addEventListener("click", () => {
          mobileMenu.classList.remove("open");
          mobileMenu.setAttribute("inert", "");
        }),
      );

      // Load saved theme
      if (localStorage.getItem("theme") === "dark") {
        document.body.classList.add("dark-mode");
      } else if (
        !localStorage.getItem("theme") &&
        window.matchMedia("(prefers-color-scheme: dark)").matches
      ) {
        document.body.classList.add("dark-mode");
      }
      updateTheme();

      updateTheme();

      (function () {
        const wrapper = document.getElementById("mascot-wrapper");
        const img = document.getElementById("mascot");

        if (!wrapper || !img) return;

        wrapper.addEventListener("click", () => {
          // scroll to #contact
          const target = document.querySelector("#contact");
          if (target) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
          }
          // small jump animation for attention
          img.style.animation = "mascot-jump .6s ease";
          setTimeout(
            () =>
              (img.style.animation = "mascot-float 4s ease-in-out infinite"),
            700,
          );
        });
      })();
    </script>

    <!-- <script>
      let slideIndex = 0;
      const slides = document.getElementsByClassName("event-img");

      function showSlides(n) {
        if (n >= slides.length) {
          slideIndex = 0;
        } else if (n < 0) {
          slideIndex = slides.length - 1;
        }

        for (i = 0; i < slides.length; i++) {
          slides[i].style.display = "none";
        }
        slides[slideIndex].style.display = "block";
      }

      function plusSlides(n) {
        slideIndex += n;
        showSlides(slideIndex);
      }

      showSlides(slideIndex);

      setInterval(() => plusSlides(1), 5000);
    </script> -->
  </body>
</html>
